<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ThatSoundsLikeMe_*_x64-setup.exe"
      product-name="ThatSoundsLikeMe"
      product-version="${version}"
      file-version="${version}"
      company-name="ThatSoundsLikeMe contributors"
      copyright="Copyright © 2026 ThatSoundsLikeMe contributors"
      max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
