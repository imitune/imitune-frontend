<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ThatSoundLikeMe.exe"
      product-name="ThatSoundLikeMe"
      product-version="${version}"
      file-version="${version}"
      company-name="ThatSoundLikeMe contributors"
      copyright="Copyright © 2026 ThatSoundLikeMe contributors"
      original-filename="ThatSoundLikeMe.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
